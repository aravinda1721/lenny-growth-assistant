# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# Application Environment (development, test, production)
APP_ENV=development
APP_PORT=8000
FRONTEND_PORT=5173

# Active LLM Provider: 'anthropic' | 'openai' | 'ollama' | 'simulated'
# 'simulated' works out-of-the-box with NO API keys or Ollama needed!
LLM_PROVIDER=simulated

# Anthropic Claude Configuration (Required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI Configuration (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Ollama Configuration (Required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Persistence Layer
# If empty, automatically falls back to native SQLite: sqlite:///./data/lenny_assistant.db
# For PostgreSQL / Supabase / Railway, supply: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/lenny_assistant.db

# Ingestion & Embedding Configuration
# Local fast cosine embedding model: 'tfidf_dense' (zero dependency) | 'all-MiniLM-L6-v2'
EMBEDDING_PROVIDER=tfidf_dense
TOP_K_RETRIEVAL=5
